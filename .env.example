# ========================================================
# MY_ISSB_Evaluator - Environment Configuration
# ========================================================

# Default LLM Provider: 'auto', 'groq', 'gemini', 'openai', or 'offline'
LLM_PROVIDER=groq

# Groq API Key (Recommended for fast inference - get a free key at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Google Gemini API Key
GEMINI_API_KEY=

# Optional: OpenAI API Key
OPENAI_API_KEY=

# Optional: Model name override (defaults to llama-3.3-70b-versatile for Groq)
# LLM_MODEL=llama-3.3-70b-versatile
