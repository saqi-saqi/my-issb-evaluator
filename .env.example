# ========================================================
# MY_ISSB_Evaluator - Environment Configuration
# ========================================================

# Active LLM Provider
LLM_PROVIDER=groq

# Groq API Key (Get a free key at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model (Recommended models: 'openai/gpt-oss-120b', 'openai/gpt-oss-20b')
GROQ_MODEL=openai/gpt-oss-120b
